DATABASE_URL=postgres://user:password@localhost:5432/tuipod
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080

# Public base URL of the FRONTEND (TUIPOD-LANDING), not this API. Used to build links in
# outgoing emails (reset-password, verify-email) and Stripe checkout/portal redirect URLs —
# all of those need a page that exists on the frontend, not a raw backend JSON/204 response.
WEB_URL=http://localhost:4321

# Background refresh interval (default: 6 hours)
REFRESH_INTERVAL_HOURS=6

# DB connection pool (defaults: max=10, min=2)
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Rate limits (requests per minute per IP)
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_FETCH=5
RATE_LIMIT_SEARCH=20
RATE_LIMIT_IMPORT=2

# SMTP (leave SMTP_HOST empty to log emails to stdout in dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Stripe billing (leave STRIPE_SECRET_KEY empty to disable billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_xxx

# Prometheus metrics token (leave empty to expose /metrics without auth — dev only)
METRICS_TOKEN=

# Firebase push notifications (leave empty to log to stdout in dev mode)
# Get from Firebase Console → Project Settings → Service Accounts → Server Key
FIREBASE_SERVER_KEY=
